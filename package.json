{
  "name": "ecommerce-distribuido",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma de comercio electronico con arquitectura de microservicios (Practica de Laboratorio 2)",
  "workspaces": [
    "packages/*",
    "services/*",
    "clients/web"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,auth,clientes,catalogo,inventario,carrito,pedidos,pagos,notif -c cyan,green,yellow,magenta,blue,red,white,gray,greenBright \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:clientes\" \"npm:dev:catalogo\" \"npm:dev:inventario\" \"npm:dev:carrito\" \"npm:dev:pedidos\" \"npm:dev:pagos\" \"npm:dev:notificaciones\"",
    "dev:gateway": "npm run dev -w @ecommerce/api-gateway",
    "dev:auth": "npm run dev -w @ecommerce/auth-service",
    "dev:clientes": "npm run dev -w @ecommerce/clientes-service",
    "dev:catalogo": "npm run dev -w @ecommerce/catalogo-service",
    "dev:inventario": "npm run dev -w @ecommerce/inventario-service",
    "dev:carrito": "npm run dev -w @ecommerce/carrito-service",
    "dev:pedidos": "npm run dev -w @ecommerce/pedidos-service",
    "dev:pagos": "npm run dev -w @ecommerce/pagos-service",
    "dev:notificaciones": "npm run dev -w @ecommerce/notificaciones-service",
    "dev:web": "npm run dev -w @ecommerce/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build -w @ecommerce/web",
    "infra:up": "docker compose up -d --wait postgres mongo redis rabbitmq mailpit",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait postgres mongo redis rabbitmq mailpit",
    "test:salud": "tsx --env-file-if-exists=.env tests/salud.ts",
    "test:e2e": "tsx --env-file-if-exists=.env tests/e2e-compra.ts",
    "test:concurrencia": "tsx --env-file-if-exists=.env tests/concurrencia-stock.ts",
    "test:http": "tsx --env-file-if-exists=.env tests/contrato-http.ts",
    "infra:carga": "docker compose --env-file .env --env-file .env.carga up -d --build --wait",
    "infra:normal": "docker compose --env-file .env up -d --build --wait",
    "sembrar:carga": "tsx --env-file-if-exists=.env scripts/sembrar-datos-carga.ts",
    "test:carga:catalogo": "bash tests/rendimiento/ejecutar.sh catalogo-busqueda",
    "test:carga:login": "bash tests/rendimiento/ejecutar.sh login",
    "test:carga:checkout": "bash tests/rendimiento/ejecutar.sh checkout",
    "test:carga:flujo": "bash tests/rendimiento/ejecutar.sh flujo-completo",
    "test:carga:bateria": "bash tests/rendimiento/bateria.sh",
    "graficas:rendimiento": "python scripts/graficas/rendimiento.py",
    "test:seguridad": "tsx --env-file-if-exists=.env tests/seguridad/verificaciones.ts",
    "test:zap:baseline": "bash tests/seguridad/zap-baseline.sh",
    "test:zap:api": "bash tests/seguridad/zap-api.sh",
    "test:zap:recorrido": "bash tests/seguridad/zap-recorrido.sh",
    "usabilidad:sus": "tsx tests/usabilidad/calcular-sus.ts",
    "usabilidad:recorrido": "tsx --env-file-if-exists=.env tests/usabilidad/recorrido.ts",
    "informe:estrategias": "tsx scripts/informes/generar-estrategias.ts && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/informes/actualizar-indice.ps1 -Docx docs/informes/Informe_Estrategias_Validacion_Pruebas.docx",
    "docs:c4": "bash scripts/c4.sh",
    "docs:openapi": "redocly lint docs/openapi/openapi.yaml docs/openapi/openapi-interna.yaml && redocly bundle docs/openapi/openapi.yaml -o services/api-gateway/especificacion/openapi.json && redocly bundle docs/openapi/openapi-interna.yaml -o docs/openapi/generado/openapi-interna.json",
    "test:openapi": "tsx tests/openapi-cobertura.ts",
    "test:unit": "vitest run",
    "test:unit:cobertura": "vitest run --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@redocly/cli": "2.78.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^8.2.2",
    "docx": "^9.5.0",
    "playwright": "1.48.2",
    "playwright-core": "1.48.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.9"
  }
}
