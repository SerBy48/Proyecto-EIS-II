# ============================================================================
# Perfil de entorno para las pruebas de carga (k6).
#
# Solo contiene las variables que cambian respecto a .env. Se aplica encima
# de el, porque Compose deja que el ultimo --env-file sobrescriba:
#
#   docker compose --env-file .env --env-file .env.carga up -d
#
# Eleva los limites del rate limiting para medir la capacidad del sistema y no
# la del limitador. Los valores por defecto del codigo NO se tocan: la corrida
# "con limites normales" se hace sin este archivo y es evidencia de seguridad.
# ============================================================================

LIMITE_GENERAL=100000
LIMITE_LOGIN=100000
LIMITE_CHECKOUT=100000

# Los logs en "info" escriben una linea por peticion; bajo carga eso es E/S que
# distorsiona la medicion. Los 5xx y 4xx siguen registrandose como warn/error.
LOG_LEVEL=warn
LIMITE_ASISTENTE=100000
LIMITE_RECUPERACION=100000
