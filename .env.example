# ============================================================================
# Variables de entorno. Copiar a .env y ajustar.
#   cp .env.example .env
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info
# LOG_FORMATO=json          # descomentar para logs estructurados
# Swagger UI en /api/docs. En produccion: false (responde como una ruta inexistente).
EXPONER_DOCS=true

# --- Seguridad --------------------------------------------------------------
# OBLIGATORIOS y sin valor por defecto: sin ellos ningun servicio arranca.
# Genere cada uno con:  openssl rand -hex 32
# (o: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Minimo 32 caracteres. Nunca reutilice un valor publicado en el repositorio.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Secreto compartido para la autenticacion mutua entre microservicios
INTERNAL_TOKEN=

# --- Bases de datos ---------------------------------------------------------
POSTGRES_PASSWORD=postgres
# Puerto del host donde se publica el contenedor. Cambiarlo si ya hay un
# PostgreSQL local escuchando en 5432 (los servicios lo leen al arrancar).
POSTGRES_PUERTO_HOST=5432
MONGO_PASSWORD=root

# --- API Gateway ------------------------------------------------------------
CORS_ORIGENES=http://localhost:5173,http://localhost:4173,http://localhost:8081

# --- Web en contenedor (nginx) y perfil de produccion -------------------------
# Puerto del host donde se publica la web (proxy /api al gateway).
WEB_PUERTO=8081
# Modo de compilacion de la web: pruebas (muestra el selector de respuestas de
# la pasarela simulada, necesario para test:e2e:ui) o production (lo oculta).
# Por defecto: pruebas en docker-compose.yml y production en el perfil prod.
# MODO_VITE=pruebas
# Origenes CORS del perfil prod (por defecto http://localhost:WEB_PUERTO). Las
# peticiones de la propia web, tambien por el tunel, no lo necesitan: nginx
# quita el Origin cuando coincide con el Host.
# CORS_ORIGENES_PROD=http://localhost:8081
LIMITE_GENERAL=300
LIMITE_LOGIN=10
LIMITE_CHECKOUT=10
PROXY_TIMEOUT_MS=15000

# --- Resiliencia ------------------------------------------------------------
HTTP_TIMEOUT_MS=3000
HTTP_REINTENTOS=2
CB_UMBRAL_FALLOS=5
CB_ESPERA_MS=15000

# --- Reglas de negocio ------------------------------------------------------
PORCENTAJE_IVA=19
COSTO_ENVIO_BASE=15000
UMBRAL_ENVIO_GRATIS=500000
MINUTOS_RESERVA=15
# Limite por cliente (RF-47): cada cliente deja al menos estas unidades para los demas (minimo 1 por cliente).
STOCK_RESERVA_CLIENTE=5
INTERVALO_BARRIDO_MS=60000
TTL_CARRITO_SEGUNDOS=604800

# --- Pasarela de pagos simulada --------------------------------------------
PASARELA_LATENCIA_MS=150
PASARELA_LATENCIA_LENTA_MS=5000
PASARELA_MONTO_MAXIMO=50000000

# --- Notificaciones ---------------------------------------------------------
CORREO_OPERACIONES=operaciones@tienda.co
# Direccion publica de la web: el correo de recuperacion de contrasena enlaza aqui
# (RF-54). Con el tunel de la defensa, la URL del tunel.
URL_WEB=http://localhost:8081
# Canal de correo: smtp (real, contra Mailpit en el laboratorio) o registro
# (solo log). En Docker Compose el host SMTP es 'mailpit'.
CANAL_CORREO=smtp
SMTP_HOST=localhost
SMTP_PUERTO=1025
CORREO_REMITENTE=Tienda en linea <no-responder@tienda.co>
# Proveedor real: SMTP_SEGURO=true, SMTP_USUARIO y SMTP_CLAVE.
# API de Mailpit que consulta test:e2e para verificar los correos.
MAILPIT_URL=http://localhost:8025

# --- Asistente virtual (Trabajo Final, Fase 3) -------------------------------
# Textos de la tienda que cita el asistente (el costo de envio, el umbral y el
# IVA son los mismos del carrito).
DIAS_ENTREGA=2 a 5
DIAS_RETRACTO=5
HORARIO_ATENCION=de lunes a viernes de 8:00 a. m. a 6:00 p. m.
# Limite de mensajes por minuto en el gateway.
LIMITE_ASISTENTE=30
# Fotos de los productos (/api/catalogo/imagenes): limite propio por IP, fuera del general.
LIMITE_IMAGENES=1500
# Enlaces de recuperacion de contrasena por IP cada 15 minutos (RF-54).
LIMITE_RECUPERACION=5
# IA opcional como respaldo de preguntas generales: desactivada | anthropic.
# Con anthropic se necesita ANTHROPIC_API_KEY. Nunca recibe datos personales.
ASISTENTE_IA=desactivada
ANTHROPIC_API_KEY=
