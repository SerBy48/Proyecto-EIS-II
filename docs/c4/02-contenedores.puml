@startuml 02-contenedores
!include lib/C4_Container.puml
!include estilo.puml
LAYOUT_TOP_DOWN()
title N2 - Contenedores: SerByTek

Person(cliente, "Cliente")
Person(interno, "Vendedor / Administrador")
System_Ext(pasarela, "Pasarela de pagos", "Simulada (pasarela.ts)")
System_Ext(ia, "Proveedor de IA", "Opcional", $tags="opcional")

System_Boundary(plataforma, "SerByTek (red Docker 'interna')") {
  Container(web, "Web", "React + Vite + Tailwind", "Tienda, panel de administracion y chat del asistente, servida por nginx (:8081), que hace proxy de /api al gateway")
  Container(movil, "App movil", "Flutter", "Tienda para clientes")
  Container(gateway, "API Gateway", "Node.js, Express, http-proxy", ":8080 en el laboratorio; en produccion solo detras de nginx. Sanea cabeceras, request_id, rate limit, valida JWT, proxy, /api/health agregado y Swagger UI")

  Container(auth, "auth-service", "Node.js/TS", ":3001 Registro, login, refresh rotatorio, usuarios internos")
  Container(clientes, "clientes-service", "Node.js/TS", ":3002 Perfiles, direcciones, historial")
  Container(catalogo, "catalogo-service", "Node.js/TS", ":3003 Productos, categorias, precios, promociones")
  Container(inventario, "inventario-service", "Node.js/TS", ":3004 Stock, reservas con TTL, movimientos, alertas")
  Container(carrito, "carrito-service", "Node.js/TS", ":3005 Carrito con TTL y cupones")
  Container(pedidos, "pedidos-service", "Node.js/TS", ":3006 Checkout (saga orquestada), ciclo de vida del pedido")
  Container(pagos, "pagos-service", "Node.js/TS", ":3007 Cobros idempotentes, transacciones sin datos de tarjeta")
  Container(notif, "notificaciones-service", "Node.js/TS", ":3008 Plantillas, envio por correo y bandeja (campana); consume eventos")
  Container(asistente, "asistente-service", "Node.js/TS", ":3009 Motor de intenciones, FAQ y consultas al vendedor")

  ContainerDb(pg, "PostgreSQL 16", "5 bases logicas con usuario propio", "auth_db, clientes_db, inventario_db, pedidos_db, pagos_db")
  ContainerDb(mongo, "MongoDB 7", "Documental", "catalogo_db, notificaciones_db, asistente_db")
  ContainerDb(redis, "Redis 7", "Clave-valor con TTL", "Carritos")
  ContainerQueue(rabbit, "RabbitMQ 3.13", "Exchange topic ecommerce.eventos + ecommerce.eventos.dlq", "Eventos de dominio")
  Container(mailpit, "Mailpit", "SMTP :1025, UI :8025", "Correo de pruebas (en produccion, Gmail por SMTP)")
}

Rel(cliente, web, "Usa", "HTTPS")
Rel(cliente, movil, "Usa")
Rel(interno, web, "Usa", "HTTPS")
Rel(web, gateway, "Llama", "REST/JSON + JWT")
Rel(movil, gateway, "Llama", "REST/JSON + JWT")

Rel(gateway, auth, "/api/auth", "REST")
Rel(gateway, clientes, "/api/clientes", "REST")
Rel(gateway, catalogo, "/api/catalogo", "REST")
Rel(gateway, inventario, "/api/inventario", "REST")
Rel(gateway, carrito, "/api/carrito", "REST")
Rel(gateway, pedidos, "/api/pedidos", "REST")
Rel(gateway, pagos, "/api/pagos", "REST")
Rel(gateway, notif, "/api/notificaciones", "REST")
Rel(gateway, asistente, "/api/asistente", "REST")

Rel(auth, clientes, "Verifica correo y cliente_id del registro", "REST sincrono")
Rel(catalogo, inventario, "Disponibilidad (circuit breaker, degrada sin stock)", "REST sincrono")
Rel(inventario, catalogo, "Nombre del SKU para alertas", "REST sincrono")
Rel(carrito, catalogo, "Precio vigente", "REST sincrono")
Rel(pedidos, clientes, "Valida cliente y direccion", "REST sincrono")
Rel(pedidos, carrito, "Lee el carrito de checkout", "REST sincrono")
Rel(pedidos, catalogo, "Relee precios (invariante 2)", "REST sincrono")
Rel(pedidos, inventario, "Reserva / confirma / libera", "REST sincrono, idempotente")
Rel(pedidos, pagos, "Cobra (sin reintento)", "REST sincrono, idempotente")
Rel(pagos, pasarela, "Autoriza", "llamada en proceso")
Rel(asistente, catalogo, "Busca productos, precio y disponibilidad", "REST sincrono")
Rel(asistente, pedidos, "Pedidos del usuario con SU JWT", "REST sincrono")
Rel(asistente, ia, "Respaldo opcional", "HTTPS", $tags="opcional")

Rel(auth, pg, "auth_db")
Rel(clientes, pg, "clientes_db")
Rel(inventario, pg, "inventario_db")
Rel(pedidos, pg, "pedidos_db")
Rel(pagos, pg, "pagos_db")
Rel(catalogo, mongo, "catalogo_db")
Rel(notif, mongo, "notificaciones_db")
Rel(asistente, mongo, "asistente_db")
Rel(carrito, redis, "carrito:{cliente_id}")

Rel(pedidos, rabbit, "pedido.confirmado, pedido.cancelado", "AMQP", $tags="asincrono")
Rel(pagos, rabbit, "pago.aprobado, pago.rechazado", "AMQP", $tags="asincrono")
Rel(inventario, rabbit, "inventario.stock_minimo, inventario.reserva_expirada", "AMQP", $tags="asincrono")
Rel(rabbit, notif, "cola notificaciones.envio: pedido.*, pago.rechazado, inventario.stock_minimo, carrito.abandonado, asistente.consulta_*, auth.recuperacion_solicitada", "AMQP", $tags="asincrono")
Rel(rabbit, clientes, "cola clientes.historial: pedido.confirmado, pedido.cancelado", "AMQP", $tags="asincrono")
Rel(asistente, rabbit, "asistente.consulta_*", "AMQP", $tags="asincrono")
Rel(auth, rabbit, "auth.recuperacion_solicitada (enlace solo en el correo)", "AMQP", $tags="asincrono")
Rel(notif, mailpit, "Correo (nodemailer, CANAL_CORREO=smtp)", "SMTP")

SHOW_LEGEND()
@enduml
