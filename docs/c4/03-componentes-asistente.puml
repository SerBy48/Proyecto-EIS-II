@startuml 03-componentes-asistente
!include lib/C4_Component.puml
!include estilo.puml
title N3 - Componentes de asistente-service (services/asistente-service/src)

Container(web, "Web", "React", "Asistente.jsx: boton flotante y panel de chat")
Container(gateway, "API Gateway", "Express", "POST /api/asistente/mensajes publica; limite de 30 por minuto")
ContainerDb(mongo, "asistente_db", "MongoDB", "conversaciones (TTL 30 dias), faq, tickets, intenciones")
ContainerQueue(rabbit, "RabbitMQ", "ecommerce.eventos")
Container(catalogo, "catalogo-service", "REST", "Productos con disponibilidad")
Container(pedidos, "pedidos-service", "REST", "Aplica RBAC y autorizacion por dato")
System_Ext(ia, "Proveedor de IA", "Claude (opcional, apagado)", $tags="opcional")

Container_Boundary(asis, "asistente-service :3009") {
  Component(router, "Router", "index.ts", "POST /mensajes, GET /conversaciones/:id, /tickets, GET/PATCH /intenciones y /faq")
  Component(ctrl, "Controlador", "controlador.ts", "identidadOpcional (token vencido -> 401), valida el texto (<= 500), conversacion con dueno, enmascara datos")
  Component(motor, "Motor de intenciones", "motor.ts (puro)", "Normaliza, puntua terminos, extrae SKU y pedido, contexto de varios turnos")
  Component(dialogo, "Arbol de dialogo", "dialogo.ts", "Respuestas: texto, productos, pedido(s), opciones; degradacion si un servicio cae")
  Component(adapt, "Adaptadores", "adaptadores.ts (ClienteServicio)", "Catalogo como interno; pedidos CON el Authorization del usuario (nunca llamada interna)")
  Component(conf, "Configuracion", "configuracion.ts", "Cifras de la FAQ desde las variables del carrito")
  Component(iaad, "Adaptador IA", "ia.ts (@anthropic-ai/sdk)", "Solo si nada supera el umbral; sin datos personales ni herramientas", $tags="opcional")
}

Rel(web, gateway, "POST /api/asistente/mensajes", "REST/JSON + JWT opcional")
Rel(gateway, router, "/api/asistente/*", "REST")
Rel(router, ctrl, "")
Rel(ctrl, motor, "texto + pendiente")
Rel(ctrl, dialogo, "intencion + entidades")
Rel(dialogo, conf, "variables")
Rel(dialogo, adapt, "consultas")
Rel(dialogo, iaad, "no_entendido", $tags="opcional")
Rel(ctrl, mongo, "conversaciones, tickets, intenciones, faq", "driver nativo")
Rel(adapt, catalogo, "GET /productos?q=, /productos/:sku, /categorias")
Rel(adapt, pedidos, "GET /, GET /:id con el JWT del usuario")
Rel(dialogo, rabbit, "asistente.escalamiento", "AMQP", $tags="asincrono")
Rel(iaad, ia, "Messages API", "HTTPS", $tags="opcional")
SHOW_LEGEND()
@enduml
